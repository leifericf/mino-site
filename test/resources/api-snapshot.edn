    :params "mino_state_t *S, mino_val_t *args, mino_env_t *env",
    :signature
    "typedef mino_val_t *(*mino_prim_fn)(mino_state_t *S, mino_val_t *args, mino_env_t *env);",
    :doc nil}
   {:kind :typedef-fn,
    :name "mino_prim_fn2",
    :return-type "mino_val_t *",
    :params
    "mino_state_t *S, mino_val_t **argv, int argc, mino_env_t *env",
    :signature
    "typedef mino_val_t *(*mino_prim_fn2)(mino_state_t *S, mino_val_t **argv, int argc, mino_env_t *env);",
    :doc
    "argv ABI: receives evaluated args as a flat C array instead of a\ncons spine. Skips eval_args' per-call cons allocation for prims\nregistered with mino_prim_argv. argv slots are GC-rooted by the\nconservative stack scan for the duration of the call."}
   {:kind :typedef-fn,
    :name "mino_finalizer_fn",
    :return-type "void",
