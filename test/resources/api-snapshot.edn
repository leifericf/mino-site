 {:name "Value retention (refs)",
  :unstable false,
  :declarations
  [{:kind :function,
    :name "mino_ref",
    :return-type "mino_ref_t *",
    :params "mino_state_t *S, mino_val_t *val",
    :signature
    "mino_ref_t *mino_ref(mino_state_t *S, mino_val_t *val);",
    :doc
    "Values returned by constructors and eval are borrowed: they survive until\nthe next GC cycle but are not pinned. A ref roots a value so it survives\ncollection indefinitely. The host must call mino_unref when the value is\nno longer needed.\n\nmino_ref_t *r = mino_ref(S, val);   // root val\nmino_val_t *v = mino_deref(r);      // get the value\nmino_unref(S, r);                   // release the root\n\nRefs are owned by the state that created them and freed when the state\nis freed, but the host should unref explicitly to avoid holding objects\nlonger than necessary."}
   {:kind :function,
    :name "mino_deref",
    :return-type "mino_val_t *",
    :params "const mino_ref_t *ref",
    :signature "mino_val_t *mino_deref(const mino_ref_t *ref);",
    :doc nil}
   {:kind :function,
    :name "mino_unref",
    :return-type "void",
    :params "mino_state_t *S, mino_ref_t *ref",
    :signature
    "void        mino_unref(mino_state_t *S, mino_ref_t *ref);",
    :doc nil}]}
